[user]
    name = @user@
    email = @email@

[core]
    editor = @editor@
    autocrlf = input
    safecrlf = true

[init]
    defaultBranch = main

[push]
    default = simple

[pull]
    rebase = false

[color]
    ui = auto

[color "branch"]
    current = yellow reverse
    local = yellow
    remote = green

[color "diff"]
    meta = yellow bold
    frag = magenta bold
    old = red bold
    new = green bold

[color "status"]
    added = yellow
    changed = green
    untracked = cyan

[alias]
    st = status
    co = checkout
    br = branch
    ci = commit
    df = diff
    lg = log --oneline --graph --decorate --all
    unstage = reset HEAD --
    last = log -1 HEAD
    visual = !gitk

[merge]
    tool = vimdiff

[diff]
    tool = vimdiff
